# WeChat Article Fetcher V3 - Environment Configuration
# Copy this file to .env and fill in the values

# Server
SERVER_PORT=8080
DB_PATH=./server/data/platform.db
JWT_SECRET=change_me_min_24_chars_jwt_secret_key
AGENT_REGISTRATION_KEY=change_me_agent_registration_key
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_password
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
ARTICLE_RETENTION_DAYS=0
LOG_RETENTION_DAYS=30
SCREENSHOT_RETENTION_DAYS=7

# Frontend
FRONTEND_PORT=3000

# Agent (for agent-side config)
LLM_BASE_URL=http://119.84.39.2:7626/v1
LLM_API_KEY=replace_with_your_own_api_key
LLM_MODEL=qwen3.8-27b
