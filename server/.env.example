APP_ENV=development
HTTP_ADDR=:8080
DB_PATH=./data/platform.db
LOG_LEVEL=info

# Use a random value with at least 32 characters in every real environment.
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_TTL=24h

# Shared only during agent provisioning. Rotate it if it is exposed.
AGENT_REGISTRATION_KEY=replace-with-a-random-registration-key

HEARTBEAT_TIMEOUT=45s
TASK_LEASE=90s
TASK_MAX_ATTEMPTS=3
DEFAULT_AGENT_MAX_CONCURRENCY=1

CORS_ALLOWED_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-start
